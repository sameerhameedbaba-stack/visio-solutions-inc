# =============================================================================
# Visio Solutions Inc. — Environment configuration example
# Copy this file to `.env.local` and fill in real values. Never commit .env.local.
# =============================================================================

# Canonical public site URL (no trailing slash). Used for metadata, canonical
# tags, sitemap, robots and structured data. Falls back to https://visiosolutions.net
NEXT_PUBLIC_SITE_URL=https://visiosolutions.net

# -----------------------------------------------------------------------------
# Contact form email delivery (provider abstraction)
# -----------------------------------------------------------------------------
# Provider selects how contact submissions are delivered:
#   console  -> logs a redacted summary to the server (default; no email sent)
#   resend   -> sends via the Resend API (requires RESEND_API_KEY)
CONTACT_EMAIL_PROVIDER=console

# Resend API key (only required when CONTACT_EMAIL_PROVIDER=resend)
# Obtain from https://resend.com. Keep this server-side only — never expose it.
RESEND_API_KEY=

# Address that receives contact-form notifications
CONTACT_TO_EMAIL=support@visiosolutions.net

# Verified sender address (must be on a domain authenticated with SPF/DKIM/DMARC)
CONTACT_FROM_EMAIL=website@visiosolutions.net

# -----------------------------------------------------------------------------
# Analytics (optional, privacy-conscious). Leave blank to disable entirely.
# -----------------------------------------------------------------------------
# Plausible domain, e.g. visiosolutions.net. When unset, no analytics loads.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# -----------------------------------------------------------------------------
# Static hosting (e.g. Hostinger shared hosting via `npm run build:static`)
# -----------------------------------------------------------------------------
# On static hosting there is no Node server, so the contact form submits to
# Web3Forms instead of /api/contact. Get a free access key at https://web3forms.com
# (enter the destination email — support@visiosolutions.net — and it is emailed to
# you). The key is a public identifier and is safe to expose in the client bundle.
# When set, the contact form delivers to the email tied to this key.
NEXT_PUBLIC_WEB3FORMS_KEY=
